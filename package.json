{
  "name": "@baileys/mongodb-store",
  "version": "2.6.0",
  "description": "MongoDB store implementation for WhiskeySockets Baileys WhatsApp Web API with multi-instance support and TTL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest src/utils/__tests__/security.test.ts src/utils/__tests__/auth.test.ts",
    "test:memory": "jest src/utils/__tests__/memory.test.ts",
    "test:ttl": "jest src/utils/__tests__/ttl.test.ts",
    "test:all-utils": "jest src/utils/__tests__/",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "mongodb",
    "store",
    "multi-instance",
    "ttl"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "baileys": "^6.7.18",
    "bullmq": "^5.56.9",
    "ioredis": "^5.7.0",
    "mongodb": "^6.3.0",
    "node-cache": "^5.1.2",
    "p-queue": "^8.1.0"
  },
  "peerDependencies": {
    "@adiwajshing/keyed-db": "*",
    "pino": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/node-cache": "^4.1.3",
    "@types/p-queue": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fatomate/baileys-mongodb-store.git"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
