{
  "name": "@fatomate/baileys-mongodb-store",
  "version": "2.30.6",
  "description": "MongoDB store implementation for WhiskeySockets Baileys WhatsApp Web API with multi-instance support and TTL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest src/utils/__tests__/security.test.ts src/utils/__tests__/auth.test.ts",
    "test:memory": "jest src/utils/__tests__/memory.test.ts",
    "test:ttl": "jest src/utils/__tests__/ttl.test.ts",
    "test:all-utils": "jest src/utils/__tests__/",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "mongodb",
    "store",
    "multi-instance",
    "ttl"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "bullmq": "^5.58.4",
    "ioredis": "^5.7.0",
    "mongodb": "^6.3.0",
    "node-cache": "^5.1.2",
    "p-queue": "^8.1.0"
  },
  "peerDependencies": {
    "@adiwajshing/keyed-db": "*",
    "pino": "*",
    "baileys": ">=7.0.0-rc.9 <8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/node-cache": "^4.1.3",
    "@types/p-queue": "^3.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "baileys": "7.0.0-rc14",
    "eslint": "^10.14.0",
    "fast-check": "^4.9.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fatomate/baileys-mongodb-store.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
